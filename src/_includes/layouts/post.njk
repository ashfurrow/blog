---
layout: layouts/base.njk
pageStylesheet: /assets/photo.css
pageJavaScript: /assets/lightbox.js
---

<article class="normal-width{% if layout == photoLayout %} photo-layout{% endif %}">
	{{ content | safe }}

	<div class="typo-correction">
		<hr>
		<a href="{% githubLink %}" class="typo-link">Please submit typo corrections on GitHub</a>
		<hr>
	</div>

	{%- if collections.posts %}
		{%- set previousPost = collections.posts | getPreviousCollectionItem %}
		{%- set nextPost = collections.posts | getNextCollectionItem %}
		{%- if nextPost or previousPost %}
			<div class="pagination">
				{%- if previousPost %}
					<a href="{{ previousPost.url }}">
						<div class="pagination-button pagination-prev">
							<div class="pagination-linktext">
								{{ previousPost.data.title }}
							</div>
						</div>
					</a>
				{% endif %}
				{%- if nextPost %}
					<a href="{{ nextPost.url }}">
						<div class="pagination-button pagination-next">
							<div class="pagination-linktext">
								{{ nextPost.data.title }}
							</div>
						</div>
					</a>
				{% endif %}
			</div>
		{%- endif %}
	{%- endif %}
</article>

<dialog id="lightbox" aria-label="Photo viewer">
	<img alt="">
	<button class="lb-close" aria-label="Close" data-lb="close">×</button>
	<button class="lb-prev" aria-label="Previous photo" data-lb="prev">‹</button>
	<button class="lb-next" aria-label="Next photo" data-lb="next">›</button>
</dialog>
