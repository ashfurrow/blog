<li class="post-item{% if markPhotos and post.photo %} photo-post{% endif %}">
  <a href="{{ post.url }}" class="post-link">
    <span class="post-title">{% if post.title %}{{ post.title }}{% else %}<code>{{ post.url }}</code>{% endif %}</span>
    <time class="post-date" datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate }}</time>
    {%- if markPhotos and post.photo %}
    {% icon "solid/image", "photo-marker", false, "Photo post" %}
    {%- endif %}
  </a>
</li>
