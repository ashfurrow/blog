---
title: Blog Archive
description: Blog archive of a compassionate software developer.
---

<article>
{% set groupedPostsJson %}{% groupedPosts %}{% endset %}
{% set groupedPosts = groupedPostsJson | fromJson  %}
{%- for group in groupedPosts %}
  <div class="group">
    <h2>{{ group.name }}</h2>
    {%- for post in group.posts %}
      <article class="post-item{% if post.photo %} photo-post{% endif %}">
        <a href="{{ post.url }}" class="post-link">
          <span class="post-title">{{ post.title }}</span>
          <time class="post-date" datetime="{{ post.date | parseDate | htmlDateString }}">{{ post.date | parseDate | readableDate }}</time>
          {% if post.photo %}<i class="fa-solid fa-image photo-marker" title="Photo post" role="img" aria-label="Photo post"></i>{% endif %}
        </a>
      </article>
    {%- endfor %}
  </div>
{%- endfor %}
</article>
